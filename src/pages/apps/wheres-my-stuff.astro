---
import { Image } from "astro:assets";
import AppIcon from "../../components/AppIcon.astro";
import Layout from "../../layouts/Layout.astro";
import AppVideo from "../../components/AppVideo.astro";
import { apps, url } from "../../data/apps";
import icon from "../../assets/wheres-my-stuff/icon.png";
import find from "../../assets/wheres-my-stuff/01_find_your_stuff.png";
import places from "../../assets/wheres-my-stuff/02_organize_your_places.png";
import details from "../../assets/wheres-my-stuff/03_save_the_details.png";
import backup from "../../assets/wheres-my-stuff/04_take_it_with_you.png";
const screenshots = [
  {
    image: find,
    title: "Find your stuff",
    alt: "Find your stuff. Search your saved belongings and remember where you put them.",
  },
  {
    image: places,
    title: "A place for everything",
    alt: "A place for everything. Organize rooms, shelves, drawers and boxes in nested places.",
  },
  {
    image: details,
    title: "Save it once. Find it later",
    alt: "Save it once. Find it later. Edit an item with its name, photo, tags, notes and location.",
  },
  {
    image: backup,
    title: "Your stuff. Your device",
    alt: "Your stuff. Your device. Offline inventory settings with backup export and import controls.",
  },
];
const storeUrl = apps.find((app) => app.slug === "wheres-my-stuff")!.storeUrl!;
const appUrl = new URL(url("apps/wheres-my-stuff/"), Astro.site).href;
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Where’s My Stuff?",
  url: appUrl,
  downloadUrl: storeUrl,
  operatingSystem: "Android",
  applicationCategory: "LifestyleApplication",
  description:
    "Remember what you own and where you put it. Organize items with photos, tags and nested places, then search your inventory on Android.",
  image: new URL(icon.src, Astro.site).href,
  author: { "@type": "Organization", name: "Velvet & Pixel" },
};
---

<Layout
  title="Where’s My Stuff? — Android Inventory Organizer"
  description="Remember what you own and where you put it. Organize items with photos, tags and nested places, then search your inventory on Android. Available on Google Play."
  socialImage={icon.src}
  socialImageAlt="Where’s My Stuff? neon cube app icon"
  structuredData={software}
>
  <section class="wrap page-head product-head">
    <p class="eyebrow">Organization &amp; Everyday Tools / Android</p>
    <span class="status">Available on Google Play</span>
    <div class="product-title">
      <AppIcon src={icon} app="wheres-my-stuff" variant="product" />
      <h1>
        Where’s
        <br />
        <em>My Stuff?</em>
      </h1>
    </div>
    <p class="intro">Less hunting. More finding.</p>
    <p>
      Remember what you own—and where you put it. Add an item, give it a place,
      and find it again with photos, tags, and search.
    </p>
    <div class="product-download">
      <a class="button" href={storeUrl}>
        Get it on Google Play <span aria-hidden="true">→</span>
      </a>
      <p class="fine">Available now for Android.</p>
    </div>
  </section>
  <section class="wrap section">
    <p class="eyebrow">From “somewhere” to right here</p>
    <h2>See where it goes.</h2>
    <p>Real screens from the app. Select a screenshot to view it full size.</p>
    <div class="screenshots">
      {screenshots.map(({ image, title, alt }) => (
        <figure class="app-screenshot">
          <a
            href={image.src}
            aria-label={`View full-size screenshot: ${title}`}
          >
            <Image
              src={image}
              alt={alt}
              widths={[280, 420, 600]}
              sizes="(max-width: 760px) 75vw, 260px"
              format="webp"
              loading="lazy"
            />
          </a>
          <figcaption>{title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section class="wrap section" aria-labelledby="demo-title">
    <p class="eyebrow">Watch the app demo</p>
    <h2 id="demo-title">A place for your stuff.</h2>
    <AppVideo
      href="https://www.youtube.com/shorts/HsG3a7QIZM4"
      appName="Where’s My Stuff?"
    />
  </section>
  <section class="wrap section" aria-labelledby="features-title">
    <p class="eyebrow">Built around everyday organization</p>
    <h2 id="features-title">Remember the details.</h2>
    <ul class="feature-summary">
      {[
        "Items with names, notes, tags, quantities and an optional photo",
        "Nested places with readable paths, from room to shelf to box",
        "Search by item name, tags or notes",
        "Move items as your storage changes",
        "Local inventory that works offline",
        "Light and dark appearances with accent choices",
      ].map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>
    <p class="fine">
      Inventory is stored on your device; export a backup before uninstalling or
      changing phones.
    </p>
  </section>
  <section class="wrap callout">
    <h2>Questions about the app?</h2>
    <a
      class="text-link"
      href="mailto:velvetandpixel@gmail.com?subject=Where%27s%20My%20Stuff%20enquiry"
    >
      Email Velvet &amp; Pixel →
    </a>
  </section>
</Layout>
