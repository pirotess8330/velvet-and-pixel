---
import { Image } from "astro:assets";
import photos from "../../assets/before-after-studio/photos.jpg";
import alignment from "../../assets/before-after-studio/alignment.jpg";
import layouts from "../../assets/before-after-studio/layouts.jpg";
import branding from "../../assets/before-after-studio/branding.jpg";
import demoArtwork from "../../assets/before-after-studio/demo-artwork.png";
import Layout from "../../layouts/Layout.astro";
import AppVideo from "../../components/AppVideo.astro";
import { url } from "../../data/apps";
const screenshots = [
  {
    image: photos,
    title: "Start with your photos",
    alt: "Photo selection screen with before and after image controls and a project name field.",
  },
  {
    image: alignment,
    title: "Fine-tune the fit",
    alt: "Alignment screen showing an overlapping photo preview, rotation control, and reset option.",
  },
  {
    image: layouts,
    title: "Choose your layout",
    alt: "Layout screen with side-by-side, top-and-bottom, and vertical-split options and export size selection.",
  },
  {
    image: branding,
    title: "Make it your own",
    alt: "Branding screen with a comparison preview, accent colors, label styles, and brand presets.",
  },
];
const features = [
  [
    "Make the comparison",
    "Align your photos and choose comparison layouts to show the change clearly.",
  ],
  [
    "Make it yours",
    "Add branding, labels and watermarks. Keep your style close with saved presets.",
  ],
  [
    "Pick up where you left off",
    "Save projects locally and return to your edits.",
  ],
  ["Ready to go", "Export finished comparisons as JPEG or PNG."],
  ["Create offline", "Edit photos on your device, without an account."],
  ["Keep it simple", "No ads. No subscriptions."],
];
---

<Layout
  title="Before & After Studio"
  description="Create polished before-and-after photo comparisons on Android. Offline editing, branding, saved projects, and JPEG or PNG exports."
>
  <section class="wrap page-head product-head">
    <p class="eyebrow">Photo & Creative Tools / Android</p>
    <span class="status">Coming Soon</span>
    <h1>
      Before &<br />
      <em>After Studio.</em>
    </h1>
    <p class="intro">
      Show the change.
      <br />
      Make the comparison your own.
    </p>
    <p>
      Create polished before-and-after comparisons from your existing photos.
      The app does not generate an “after” image.
    </p>
    <p class="availability">
      In review on Google Play. The download link will appear when the listing
      is public.
    </p>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Your photos. Your perspective.</p>
        <h2>A polished finish.</h2>
      </div>
    </div>
    <div class="feature-grid">
      {features.map(([title, description], i) => (
        <article>
          <span class="eyebrow">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="wrap section">
    <p class="eyebrow">A closer look</p>
    <h2>Inside the studio.</h2>
    <p>Explore photo selection, alignment, layouts, and branding in the app.</p>
    <div class="screenshots">
      {screenshots.map(({ image, title, alt }) => (
        <figure class="app-screenshot">
          <a
            href={image.src}
            aria-label={`View full-size screenshot: ${title}`}
          >
            <Image
              src={image}
              alt={alt}
              widths={[280, 420, 600]}
              sizes="(max-width: 760px) 75vw, 260px"
              format="webp"
              loading="lazy"
            />
          </a>
          <figcaption>{title}</figcaption>
        </figure>
      ))}
    </div>
    <p class="fine">Select a screenshot to view it full size.</p>
  </section>
  <section class="wrap section demo-section" aria-labelledby="demo-title">
    <p class="eyebrow">From photos to a finished comparison</p>
    <h2 id="demo-title">Watch the workflow.</h2>
    <p>Take a look at Before &amp; After Studio in action.</p>
    <AppVideo
      href="https://www.youtube.com/shorts/ou8AF8JMvaw"
      appName="Before & After Studio"
      poster={demoArtwork}
    />
  </section>
  <section class="wrap section pricing">
    <div>
      <p class="eyebrow">One purchase. More possibilities.</p>
      <h2>
        Start free.
        <br />
        <em>Go unlimited.</em>
      </h2>
      <p>
        Free download, with one free finished comparison successfully saved or
        shared.
      </p>
      <p class="fine">
        For sharing, the allowance is used when you select a destination in
        Android’s share menu, including system Copy/Edit actions. Cancelling the
        menu does not count; completion inside another app cannot be confirmed.
      </p>
    </div>
    <div class="price-card">
      <span class="eyebrow">Pro / one-time unlock</span>
      <p class="price">
        $7.99 <span>USD</span>
      </p>
      <h3>Unlimited exports</h3>
      <p>
        No ads or subscriptions. The localized checkout price is determined by
        Google Play.
      </p>
      <p class="quiet">Available when the app launches.</p>
    </div>
  </section>
  <section class="wrap callout">
    <h2>Questions before you create?</h2>
    <div>
      <a class="text-link" href={url("support/")}>
        Read the FAQ{" "}
        <svg class="arrow" aria-hidden="true" viewBox="0 0 20 20" fill="none">
          <path
            d="M4 16 16 4M4 4h12v12"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
      </a>
      <a class="text-link" href={url("privacy/before-after-studio/")}>
        Privacy policy{" "}
        <svg class="arrow" aria-hidden="true" viewBox="0 0 20 20" fill="none">
          <path
            d="M4 16 16 4M4 4h12v12"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
      </a>
    </div>
  </section>
</Layout>
