---
import { Image } from "astro:assets";
import AppVideo from "../../components/AppVideo.astro";
import AppIcon from "../../components/AppIcon.astro";
import icon from "../../assets/cursed-gem-windows/celestial-moon-icon.png";
import Layout from "../../layouts/Layout.astro";
import { url } from "../../data/apps";
import {
  chapelShowcases,
  gameScreenshots,
  promotionalScreenshots,
} from "../../data/cursed-gem-media";
import banner from "../../assets/cursed-gem-windows/banner.webp";
const software = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Cursed Gem Windows",
  url: new URL(url("apps/cursed-gem-windows/"), Astro.site).href,
  operatingSystem: "Android",
  applicationCategory: "GameApplication",
  genre: "Puzzle",
  description:
    "Restore stained-glass windows in a gothic gem puzzle game. Preview nine themed chapels and Grand Restorations in the upcoming expansion, with Peaceful and Challenge play.",
  image: new URL(banner.src, Astro.site).href,
  author: { "@type": "Organization", name: "Velvet & Pixel" },
};
---

<Layout
  title="Cursed Gem Windows — Gothic Stained-Glass Puzzle Game"
  description="Preview nine gothic chapels, luminous stained-glass puzzles and Grand Restorations in Cursed Gem Windows’ upcoming Android expansion."
  socialImage={banner.src}
  socialImageAlt="Cursed Gem Windows: Find your light, with windows and jeweled settings from a selection of chapels"
  structuredData={software}
>
  <section class="wrap page-head game-intro">
    <p class="eyebrow">Puzzle Game / Android</p>
    <span class="status">In Development</span>
    <div class="product-title">
      <AppIcon src={icon} app="cursed-gem-windows" variant="product" />
      <h1>
        Cursed Gem
        <br />
        <em>Windows.</em>
      </h1>
    </div>
    <p class="intro">Arrange the gems. Restore the light.</p>
    <p>
      Step into a world of candlelit chapels, jeweled glass, and windows waiting
      to shine again. Bring order to the gems, restore intricate stained-glass
      designs, and uncover a collection of luminous windows—one puzzle at a
      time.
    </p>
    <p class="availability">
      Expansion preview: three new worlds and Grand Restorations are in
      development. Expansion images show the upcoming update, not a published Google
      Play release.
    </p>
  </section>
  <figure class="wrap game-banner">
    <Image
      src={banner}
      alt="Find your light: Cursed Gem Windows promotional artwork combining stained-glass windows and jeweled settings from a selection of chapels."
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 760px) 90vw, 1200px"
      format="webp"
      loading="eager"
    />
    <figcaption>
      Find your light · Promotional artwork featuring a selection of chapels.
      Not a gameplay screenshot.
    </figcaption>
  </figure>
  <section class="wrap section" aria-labelledby="promo-title">
    <p class="eyebrow">A closer look</p>
    <h2 id="promo-title">Follow the gems. Find the light.</h2>
    <p>
      Explore the original game and its upcoming expansion in these enhanced
      screenshots. Select one to view it full size.
    </p>
    <div class="screenshots game-promos">
      {promotionalScreenshots.map(({ image, title, alt }) => (
        <figure class="app-screenshot">
          <a
            href={image.src}
            aria-label={`View full-size screenshot: ${title}`}
          >
            <Image
              src={image}
              alt={alt}
              widths={[280, 420, 600]}
              sizes="(max-width: 760px) 75vw, 380px"
              format="webp"
              loading="lazy"
            />
          </a>
          <figcaption>{title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section class="wrap section demo-section" aria-labelledby="demo-title">
    <p class="eyebrow">See the light return</p>
    <h2 id="demo-title">Cursed Gem Windows in motion.</h2>
    <AppVideo
      href="https://www.youtube.com/watch?v=93B7MufBgNo"
      appName="Cursed Gem Windows"
      poster={banner}
    />
  </section>
  <section class="wrap section" aria-labelledby="chapels-title">
    <p class="eyebrow">Nine worlds behind the glass</p>
    <h2 id="chapels-title">Find your light.</h2>
    <p>
      From candlelit gold to midnight violet, each chapel has a world of its
      own. These promotional showcases bring together its windows and optional
      cosmetic looks.
    </p>
    <p class="fine">
      Promotional artwork, not gameplay screenshots. Four original chapels are
      free; Obsidian Organum and Crimson Vespers are optional premium chapels.
      The upcoming expansion adds Emerald Abyss, Astral Basilica and Cathedral
      of Cascades as optional premium chapels. Cosmetic upgrades are optional.
    </p>
    <div class="chapel-showcases">
      {chapelShowcases.map(({ image, title, detail, alt }) => (
        <figure>
          <a
            href={image.src}
            aria-label={`View full-size ${title} promotional showcase`}
          >
            <Image
              src={image}
              alt={alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 760px) 90vw, 560px"
              format="webp"
              loading="lazy"
            />
          </a>
          <figcaption>
            <h3>{title}</h3>
            <span>{detail}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section class="wrap section" aria-labelledby="gameplay-title">
    <p class="eyebrow">Captured in the game</p>
    <h2 id="gameplay-title">
      From the first gem
      <br />
      <em>to the restored window.</em>
    </h2>
    <p>
      Actual in-game screens from the original game and the upcoming expansion:
      restored windows, the collection, gem customization, puzzles, level maps
      and Grand Restorations. Select any image to see it full size.
    </p>
    <div class="screenshots">
      {gameScreenshots.map(({ image, title, alt }) => (
        <figure class="app-screenshot">
          <a
            href={image.src}
            aria-label={`View full-size game screenshot: ${title}`}
          >
            <Image
              src={image}
              alt={alt}
              widths={[280, 420, 600]}
              sizes="(max-width: 760px) 75vw, 260px"
              format="webp"
              loading="lazy"
            />
          </a>
          <figcaption>{title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section class="wrap section" aria-labelledby="coming-title">
    <p class="eyebrow">Coming soon to Android</p>
    <h2 id="coming-title">
      Something beautiful
      <br />
      <em>waits beyond the glass.</em>
    </h2>
    <p class="game-lead">
      Take the peaceful path and settle into the restoration, or choose
      Challenge play for a different test. Explore chapels with their own
      atmosphere, complete their puzzles, and collect the windows you bring back
      to life.
    </p>
    <div class="feature-grid">
      <article>
        <p class="eyebrow">Restore</p>
        <h3>Light, piece by piece.</h3>
        <p>
          Work through gem puzzles and restore stained-glass windows with
          intricate patterns and ornate settings.
        </p>
      </article>
      <article>
        <p class="eyebrow">Explore</p>
        <h3>A chapel for every mood.</h3>
        <p>
          Four free chapels and five optional premium chapels in the expanded
          game, with 30 levels per chapel in Peaceful and Challenge modes.
        </p>
      </article>
      <article>
        <p class="eyebrow">Grand Restorations / upcoming</p>
        <h3>A whole sanctuary, piece by piece.</h3>
        <p>
          Work through puzzles to reveal larger installations in Candlelit Abbey
          and Moonlit Cathedral. Abbey is included; Moonlit is an optional
          separate one-time purchase in the upcoming release.
        </p>
      </article>
      <article>
        <p class="eyebrow">Make it yours</p>
        <h3>Keep a little of the magic.</h3>
        <p>
          Build a collection of restored windows and discover optional cosmetic
          upgrades for your game.
        </p>
      </article>
    </div>
    <p class="availability">
      Still in development, with the finishing touches underway. The Google Play
      link will appear here when the game is publicly available.
    </p>
  </section>
  <section class="wrap callout">
    <h2>Meet you at the next window.</h2>
    <div>
      <a class="text-link" href={url("privacy/cursed-gem-windows/")}>
        Privacy policy →
      </a>
      <a
        class="text-link"
        href="mailto:velvetandpixel@gmail.com?subject=Cursed%20Gem%20Windows%20enquiry"
      >
        Ask the studio →
      </a>
    </div>
  </section>
</Layout>

<style>
  @media (min-width: 761px) {
    .game-promos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
