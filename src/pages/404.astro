---
import Layout from "../layouts/Layout.astro";
import { url } from "../data/apps";
---

<Layout
  title="Page not found"
  description="This page is off the canvas. Return to Velvet & Pixel’s homepage or explore our apps and games."
>
  <section class="wrap page-head error-page">
    <p class="eyebrow">404 / Signal lost</p>
    <h1>
      A loose <em>connection.</em>
    </h1>
    <p class="intro">
      We couldn’t find that page. Let’s get you back to the studio.
    </p>
    <a class="button" href={url()}>
      Back to the studio{" "}
      <svg class="arrow" aria-hidden="true" viewBox="0 0 20 20" fill="none">
        <path
          d="M4 16 16 4M4 4h12v12"
          stroke="currentColor"
          stroke-width="1.5"
        />
      </svg>
    </a>
  </section>
</Layout>
