---
import { Image } from "astro:assets";
import type { App } from "../data/apps";
import { url } from "../data/apps";
interface Props {
  app: App;
  index?: number;
}
const { app, index = 1 } = Astro.props;
---

<article class="app-card">
  <div
    class:list={["app-art", app.slug, { "app-art-image": app.artwork }]}
    aria-hidden="true"
  >
    {app.artwork ? (
      <Image
        src={app.artwork}
        alt=""
        widths={[400, 640, 1000]}
        sizes="(max-width: 760px) calc(100vw - 40px), 550px"
        format="webp"
        loading="lazy"
      />
    ) : app.slug === "cursed-gem-mosaics" ? (
      <div class="gem">◇</div>
    ) : (
      <div class="project-monogram">
        {app.slug === "tattoo-stencil-generator" ? "TS" : "PR"}
        <span>VELVET & PIXEL / UPCOMING</span>
      </div>
    )}
    {!app.artwork && <span class="art-caption">{app.category}</span>}
  </div>
  <div class="card-content">
    <div class="meta">
      <span>
        0{index} / {app.platform}
      </span>
      <span class="status">{app.status}</span>
    </div>
    <div class="card-app-title">
      {app.icon && (
        <Image
          src={app.icon}
          alt=""
          width={64}
          height={64}
          widths={[64, 128]}
          sizes="64px"
          format="webp"
          loading="lazy"
        />
      )}
      <h3>{app.name}</h3>
    </div>
    <p>{app.description}</p>
    {app.href ? (
      <a class="text-link" href={url(app.href)}>
        Explore the app{" "}
        <span aria-hidden="true">
          <svg class="arrow" aria-hidden="true" viewBox="0 0 20 20" fill="none">
            <path
              d="M4 16 16 4M4 4h12v12"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
        </span>
      </a>
    ) : (
      <span class="quiet">
        {app.status === "Planned"
          ? "On the studio roadmap"
          : "Taking shape in the studio"}
      </span>
    )}
  </div>
</article>
