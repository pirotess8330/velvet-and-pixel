---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  href: string;
  appName: string;
  poster?: ImageMetadata;
}
const { href, appName, poster } = Astro.props;
---

<a
  class:list={["app-video", { "app-video-with-poster": poster }]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Watch the ${appName} demo on YouTube (opens in a new tab)`}
>
  {poster && (
    <Image
      src={poster}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(max-width: 760px) calc(100vw - 40px), 800px"
      loading="lazy"
    />
  )}
  <div class="app-video-content">
    <span class="video-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
    <span class="eyebrow">See it in action</span>
    <strong>{appName}</strong>
    <span class="video-cta">
      Watch the demo on YouTube{" "}
      <svg class="arrow" aria-hidden="true" viewBox="0 0 20 20" fill="none">
        <path
          d="M4 16 16 4M4 4h12v12"
          stroke="currentColor"
          stroke-width="1.5"
        />
      </svg>
    </span>
    <span class="video-note">Opens in a new tab</span>
  </div>
</a>
