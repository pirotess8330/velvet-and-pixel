---
import { Image } from "astro:assets";
import alignment from "../assets/before-after-studio/alignment.jpg";
import layouts from "../assets/before-after-studio/layouts.jpg";
import branding from "../assets/before-after-studio/branding.jpg";
import website from "../assets/portfolio/website-product.png";
import { url } from "../data/apps";
---

<section
  id="case-studies"
  class="wrap section case-studies"
  aria-labelledby="case-title"
>
  <p class="eyebrow">Independent work. Practical problems.</p>
  <h2 id="case-title">A look at the build.</h2>
  <p>
    Original studio projects showing how I approach useful software and
    thoughtful interfaces.
  </p>
  <article class="case-study">
    <div class="case-media case-app-media">
      {[
        {
          src: alignment,
          alt: "Photo alignment with a ghost overlay in Before & After Studio.",
        },
        {
          src: layouts,
          alt: "Comparison layout controls in Before & After Studio.",
        },
        {
          src: branding,
          alt: "Branding colors, labels and presets in Before & After Studio.",
        },
      ].map(({ src, alt }) => (
        <Image src={src} alt={alt} width={240} format="webp" loading="lazy" />
      ))}
    </div>
    <div class="case-copy">
      <p class="eyebrow">Independent studio project · In Google Play review</p>
      <h3>Before &amp; After Studio</h3>
      <p>
        <strong>The problem.</strong> Comparing two photos involves more than
        placing them together: alignment, presentation, and branding affect how
        clearly the change reads.
      </p>
      <p>
        <strong>What I built.</strong> An Android photo-comparison app with
        alignment controls, comparison layouts, branding, saved projects, and
        JPEG/PNG exports.
      </p>
      <p>
        <strong>Intended benefit.</strong> Bring those steps into one consistent
        editing workflow, with photos and projects kept on the device.
      </p>
      <a class="text-link" href={url("apps/before-after-studio/")}>
        Explore the app →
      </a>
      <a
        class="text-link"
        href="https://www.youtube.com/shorts/ou8AF8JMvaw"
        target="_blank"
        rel="noopener noreferrer"
      >
        Watch the demo on YouTube <span class="fine">(new tab)</span>{" "}
        <svg class="arrow" aria-hidden="true" viewBox="0 0 20 20" fill="none">
          <path
            d="M4 16 16 4M4 4h12v12"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
      </a>
    </div>
  </article>
  <article class="case-study">
    <div class="case-media case-web-media">
      <Image
        src={website}
        alt="Velvet & Pixel’s live Before & After Studio product page with its app icon, introduction and navigation."
        widths={[400, 700, 1100]}
        sizes="(max-width: 760px) 90vw, 550px"
        format="webp"
        loading="lazy"
      />
    </div>
    <div class="case-copy">
      <p class="eyebrow">Own-business project · Live</p>
      <h3>Velvet &amp; Pixel website</h3>
      <p>
        <strong>The problem.</strong> The studio needed one place to introduce
        its apps, explain availability, and provide support and privacy
        information.
      </p>
      <p>
        <strong>What I built.</strong> A responsive static website with a
        structured app catalog, product pages, real app media, and reusable
        components.
      </p>
      <p>
        <strong>The result.</strong> A live website that presents the studio’s
        work and can grow as more products launch.
      </p>
      <a class="text-link" href={url("apps/")}>
        Explore the catalog →
      </a>
    </div>
  </article>
  <div class="portfolio-contact">
    <h3>Have a problem to solve?</h3>
    <a
      class="button"
      href="mailto:velvetandpixel@gmail.com?subject=Project%20enquiry"
    >
      Email me about a project{" "}
      <svg class="arrow" aria-hidden="true" viewBox="0 0 20 20" fill="none">
        <path
          d="M4 16 16 4M4 4h12v12"
          stroke="currentColor"
          stroke-width="1.5"
        />
      </svg>
    </a>
  </div>
</section>
